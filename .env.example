# ─── Supabase ────────────────────────────────────────────────────────────────
# The public pair. Read on every request and passed to the browser by a server
# component, so these take effect on reload — no rebuild, and no NEXT_PUBLIC_
# prefix required. (NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY still work if a host
# is already set up that way.)
#
# Without them the site still runs: the directory renders and the application
# form works; only sign-in is unavailable.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Bypasses row level security — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ─── LinkedIn sign-in ────────────────────────────────────────────────────────
# There is nothing to set here — the credentials live in Supabase, not in the
# app. In the Supabase dashboard: Authentication > Providers > LinkedIn (OIDC),
# and paste the Client ID and Secret from your LinkedIn app.
#
# In the LinkedIn developer portal, the app needs the "Sign In with LinkedIn
# using OpenID Connect" product, and this redirect URL:
#   https://<your-project>.supabase.co/auth/v1/callback
# For local development with the Supabase CLI:
#   http://localhost:54321/auth/v1/callback
#
# Scopes are openid, profile and email — the only ones that product offers.

# ─── The AI judge ────────────────────────────────────────────────────────────
# Without a key, applications that clear the arithmetic rules go to a human
# rather than being auto-approved.
ANTHROPIC_API_KEY=
# Optional override. Defaults to claude-opus-5.
CIRCLEIN_JUDGE_MODEL=

# ─── Tenure source ───────────────────────────────────────────────────────────
# Sign-in proves who someone is; it does NOT reveal how long they have held
# their job, because LinkedIn does not publish work history to third parties.
# This is where the three-month rule gets its dates from.
#
# mock   — deterministic fake data, so the flow works with no vendor (default)
# http   — a licensed profile API; see LINKEDIN_PROVIDER_URL below
# manual — the applicant's own declaration, always routed to a human
LINKEDIN_PROVIDER=mock
# Called as GET <url>?url=<linkedin profile url>, with the key as a bearer token.
LINKEDIN_PROVIDER_URL=
LINKEDIN_PROVIDER_KEY=

# ─── Verification policy ─────────────────────────────────────────────────────
# Months in the current role. The rule the network is built on.
CIRCLEIN_MIN_TENURE_MONTHS=3
# Months since the LinkedIn account was created.
CIRCLEIN_MIN_ACCOUNT_AGE_MONTHS=12
# Applications accepted per IP per hour.
CIRCLEIN_RATE_LIMIT_PER_HOUR=5
# Members per WhatsApp group before the next one opens.
CIRCLEIN_WHATSAPP_CAPACITY=200

# ─── Admin ───────────────────────────────────────────────────────────────────
# Shared secret for /admin. Generate with: openssl rand -base64 32
CIRCLEIN_ADMIN_TOKEN=
